# --- Orchestrator monitoring ---------------------------------------------
# The shared monitoring module is stateless: state written there means someone
# forgot ORCH_STATE_DIR. Per-task state under .claude/local-orchestrators/ IS
# tracked history and must NOT be ignored (see .claude/shared/monitoring/monitoring.md).
.claude/shared/monitoring/events.jsonl
.claude/shared/monitoring/.watcher-state.json

# Daemon logs are runtime noise; events.jsonl is the source of truth.
.claude/local-orchestrators/*/*.log

# Watcher checkpoints are derived, restart-safe state, not history: they are
# rebuilt from journal.jsonl on restart. `events.jsonl` under
# .claude/local-orchestrators/ stays TRACKED — it is the irreplaceable stream.
.claude/local-orchestrators/*/.watcher-state.json

# --- Touch runtime state --------------------------------------------------
# .touch/ holds raw PTY capture and the hook spool: verbatim terminal output,
# tokens and prompt text by construction. It must be ignored BEFORE any code
# creates it. .touch*/ covers TOUCH_STATE_DIR variants (.touch-dev/, ...).
.touch/
.touch*/
*.pid

# Per-machine harness overrides (never shared, may hold local paths/secrets).
.claude/settings.local.json

# --- Mongo mirror ---------------------------------------------------------
# No Mongo data directory and no dump ever lives inside the repo: the mirror
# holds the same unredacted transcripts .touch/ exists to protect.
mongo-data/
mongo-dump/
# *.bson is unanchored on purpose (dumps land wherever mongodump is run). If a
# .bson ever needs to be a committed test fixture, negate it explicitly rather
# than narrowing this rule: !tests/fixtures/**/*.bson
*.bson

