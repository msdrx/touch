__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

